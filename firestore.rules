rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Moderators are listed in /moderators/{uid}. Those docs are created BY HAND in the
    // Firebase console only -- no client can ever write them (see /moderators below).
    function isModerator() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /moderators/{uid} {
      // A signed-in mom may only check whether SHE is a moderator. Writes: never.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /posts/{postId} {
      allow read: if request.auth != null;
      // Anonymous posts must not carry an author name, enforced here as well as in
      // the client, so a modified client can't leak a mom's name on an anon post.
      allow create: if request.auth != null && 
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.body is string &&
                    request.resource.data.body.size() <= 4000 &&
                    request.resource.data.get('title', '') is string &&
                    request.resource.data.get('title', '').size() <= 300 &&
                    (request.resource.data.get('anon', false) != true ||
                     request.resource.data.get('author', null) == null) &&
                    request.resource.data.get('replyCount', 0) == 0;
      // Any signed-in mom may bump replyCount by exactly +1 when she replies
      // (client uses updateDoc(increment(1))); no other field may change.
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
                    request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1;
      // The author may delete her own post; a moderator may delete any post.
      allow delete: if request.auth != null && (isModerator() || resource.data.uid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.body is string &&
                      request.resource.data.body.size() <= 4000 &&
                      (request.resource.data.get('anon', false) != true ||
                       request.resource.data.get('author', null) == null);
        allow delete: if request.auth != null && (isModerator() || resource.data.uid == request.auth.uid);
      }
    }
    
    // Reports: any signed-in mom can file one (the reporter can't be forged); only
    // moderators can read them or delete them (dismiss / clean up after a removal).
    match /reports/{reportId} {
      allow create: if request.auth != null &&
                    request.resource.data.reporterUid == request.auth.uid;
      allow read, delete: if isModerator();
    }
  }
}
